generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HospitalStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum ScopeType {
  HOSPITAL
  FLOOR
  WARD
  DEPARTMENT
}

enum AuditActorType {
  SYSTEM
  STAFF
  PLATFORM
}

// Where a role applies: the whole hospital, one floor, or one ward. The place
// itself is chosen when the role is given to a person.
enum RoleScopeLevel {
  HOSPITAL
  FLOOR
  WARD
  DEPARTMENT
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  INACTIVE
  MAINTENANCE
}

// Clinical unit types, so one model fits general wards, critical care,
// emergency, day care, maternity, and specialty units.
enum WardType {
  GENERAL
  PRIVATE
  SEMI_PRIVATE
  ICU
  HDU
  CCU
  NICU
  PICU
  EMERGENCY
  DAY_CARE
  MATERNITY
  LABOUR_ROOM
  PEDIATRIC
  ISOLATION
  BURNS
  DIALYSIS
  RECOVERY
  PSYCHIATRY
  OTHER
}

enum RoomType {
  GENERAL
  PRIVATE
  SEMI_PRIVATE
  DELUXE
  SUITE
  ISOLATION
  OTHER
}

// Any place a patient is cared for can carry a QR: beds, cots, trolleys,
// and treatment chairs.
enum BedType {
  STANDARD
  ICU
  VENTILATOR
  ISOLATION
  PEDIATRIC_COT
  NEONATAL
  DAY_CARE_CHAIR
  DIALYSIS_CHAIR
  EMERGENCY_TROLLEY
  LABOUR
  OTHER
}

enum QrCodeStatus {
  ACTIVE
  REVOKED
}

enum BedSessionStatus {
  ACTIVE
  CLOSED
}

enum DutyStatus {
  ON_DUTY
  OFF_DUTY
}

// URGENT means operationally urgent, never a medical emergency.
enum RequestPriority {
  NORMAL
  HIGH
  URGENT
}

enum EscalationTarget {
  ASSIGNEE
  ROLE
}

enum RequestStatus {
  SUBMITTED
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
  REJECTED
}

enum AssignmentMode {
  MANUAL
  POOL
  DIRECT
  AUTO_ASSIGN
}

enum RequestActorType {
  GUEST
  STAFF
  SYSTEM
}

enum RequestEventType {
  SUBMITTED
  ASSIGNED
  ACCEPTED
  STARTED
  COMPLETED
  CLOSED
  CANCELLED
  REJECTED
  TRANSFERRED
}

// A customer of the CARE QR platform: a hospital group or a single hospital.
// It owns one or more hospitals. Super admins manage clients and hospitals;
// a hospital is open to staff and patients only while it and its client are
// both active. Nothing clinical is stored here.
model Client {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  code         String       @unique
  status       ClientStatus @default(ACTIVE)
  contactName  String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  hospitals    Hospital[]
}

model Hospital {
  id                 String               @id @default(uuid()) @db.Uuid
  clientId           String               @db.Uuid
  name               String
  code               String               @unique
  timezone           String
  status             HospitalStatus       @default(ACTIVE)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  settings           HospitalSetting[]
  memberships        HospitalMembership[]
  roles              Role[]
  auditLogs          AuditLog[]
  sessions           StaffSession[]
  buildings          Building[]
  floors             Floor[]
  qrCodes            BedQrCode[]
  bedSessions        BedSession[]
  guestSessions      GuestSession[]
  departments        Department[]
  serviceCategories  ServiceCategory[]
  slaPolicies        SlaPolicy[]
  escalationPolicies EscalationPolicy[]
  serviceRequests    ServiceRequest[]
  logo               HospitalLogo?
  client             Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([clientId])
}

// A hospital's logo (SaaS branding), kept out of Hospital so ordinary queries
// never load image bytes. publicId changes on every upload, so the logo URL can
// be cached forever and old URLs simply stop resolving.
model HospitalLogo {
  hospitalId  String   @id @db.Uuid
  publicId    String   @unique @default(uuid()) @db.Uuid
  contentType String
  data        Bytes
  byteSize    Int
  updatedAt   DateTime @updatedAt
  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
}

model HospitalSetting {
  id         String   @id @default(uuid()) @db.Uuid
  hospitalId String   @db.Uuid
  key        String
  value      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  @@unique([hospitalId, id])
  @@unique([hospitalId, key])
  @@index([hospitalId])
}

model User {
  id            String               @id @default(uuid()) @db.Uuid
  email         String               @unique
  displayName   String
  passwordHash  String
  status        UserStatus           @default(ACTIVE)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  memberships   HospitalMembership[]
  platformAdmin PlatformAdmin?
}

// SaaS platform operators: they onboard and manage client hospitals, outside
// any one hospital. They never see patients or requests.
model PlatformAdmin {
  userId    String            @id @db.Uuid
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions  PlatformSession[]
}

model PlatformSession {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  tokenHash String        @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime      @default(now())
  admin     PlatformAdmin @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@index([userId])
}

model HospitalMembership {
  id               String               @id @default(uuid()) @db.Uuid
  hospitalId       String               @db.Uuid
  userId           String               @db.Uuid
  status           MembershipStatus     @default(ACTIVE)
  // Operational availability for routing; independent of authorization.
  dutyStatus       DutyStatus           @default(OFF_DUTY)
  dutyChangedAt    DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  hospital         Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  userRoles        UserRole[]
  sessions         StaffSession[]
  departments      StaffDepartment[]
  locationScopes   StaffLocationScope[]
  shifts           Shift[]
  assignedRequests ServiceRequest[]

  @@unique([hospitalId, id])
  @@unique([hospitalId, userId])
  @@index([userId])
}

model Role {
  id               String            @id @default(uuid()) @db.Uuid
  hospitalId       String            @db.Uuid
  name             String
  description      String?
  active           Boolean           @default(true)
  scopeLevel       RoleScopeLevel    @default(HOSPITAL)
  // Built-in roles every hospital gets (HOSPITAL_MANAGER, FLOOR_MANAGER, ...).
  systemKey        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  hospital         Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  rolePermissions  RolePermission[]
  userRoles        UserRole[]
  escalationLevels EscalationLevel[]

  @@unique([hospitalId, id])
  @@unique([hospitalId, name])
  @@unique([hospitalId, systemKey])
  @@index([hospitalId])
}

model Permission {
  key             String           @id
  description     String
  rolePermissions RolePermission[]
}

model RolePermission {
  id            String     @id @default(uuid()) @db.Uuid
  hospitalId    String     @db.Uuid
  roleId        String     @db.Uuid
  permissionKey String
  role          Role       @relation(fields: [hospitalId, roleId], references: [hospitalId, id], onDelete: Restrict)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@unique([hospitalId, roleId, permissionKey])
  @@index([hospitalId, roleId])
}

model UserRole {
  id           String             @id @default(uuid()) @db.Uuid
  hospitalId   String             @db.Uuid
  membershipId String             @db.Uuid
  roleId       String             @db.Uuid
  membership   HospitalMembership @relation(fields: [hospitalId, membershipId], references: [hospitalId, id], onDelete: Restrict)
  role         Role               @relation(fields: [hospitalId, roleId], references: [hospitalId, id], onDelete: Restrict)
  scopes       ScopeAssignment[]

  @@unique([hospitalId, id])
  @@unique([hospitalId, membershipId, roleId])
  @@index([hospitalId, roleId])
}

model ScopeAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  hospitalId String    @db.Uuid
  userRoleId String    @db.Uuid
  scopeType  ScopeType
  scopeId    String    @db.Uuid
  userRole   UserRole  @relation(fields: [hospitalId, userRoleId], references: [hospitalId, id], onDelete: Restrict)

  @@unique([hospitalId, userRoleId, scopeType, scopeId])
  @@index([hospitalId, scopeType, scopeId])
}

model StaffSession {
  id           String             @id @default(uuid()) @db.Uuid
  hospitalId   String             @db.Uuid
  membershipId String             @db.Uuid
  tokenHash    String             @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime           @default(now())
  lastSeenAt   DateTime           @default(now())
  hospital     Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  membership   HospitalMembership @relation(fields: [hospitalId, membershipId], references: [hospitalId, id], onDelete: Restrict)

  @@index([hospitalId, membershipId])
  @@index([expiresAt])
}

model AuditLog {
  id                  String         @id @default(uuid()) @db.Uuid
  hospitalId          String         @db.Uuid
  actorType           AuditActorType
  actorMembershipId   String?        @db.Uuid
  // Set when a platform administrator acted on this hospital.
  actorPlatformUserId String?        @db.Uuid
  action              String
  targetType          String
  targetId            String
  metadata            Json
  requestId           String?
  createdAt           DateTime       @default(now())
  hospital            Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  @@index([hospitalId, createdAt])
  @@index([hospitalId, targetType, targetId])
}

// Location hierarchy: Hospital -> Building? -> Floor -> Ward -> Room? -> Bed.
// Parent links are composite (hospitalId, parentId) foreign keys, so the
// database rejects a parent that belongs to another hospital.

model Building {
  id         String   @id @default(uuid()) @db.Uuid
  hospitalId String   @db.Uuid
  code       String
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  floors     Floor[]

  @@unique([hospitalId, id])
  @@unique([hospitalId, code])
}

model Floor {
  id          String               @id @default(uuid()) @db.Uuid
  hospitalId  String               @db.Uuid
  buildingId  String?              @db.Uuid
  code        String
  name        String
  // Physical level for ordering: -1 basement, 0 ground, 1 first, ...
  level       Int?
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  hospital    Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  building    Building?            @relation(fields: [hospitalId, buildingId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  wards       Ward[]
  staffScopes StaffLocationScope[]

  // Floor codes are unique per building (and among floors with no building);
  // both rules are partial unique indexes in migration 07.
  @@unique([hospitalId, id])
  @@index([hospitalId, buildingId])
}

model Ward {
  id          String               @id @default(uuid()) @db.Uuid
  hospitalId  String               @db.Uuid
  floorId     String               @db.Uuid
  code        String
  name        String
  unitType    WardType             @default(GENERAL)
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  floor       Floor                @relation(fields: [hospitalId, floorId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  rooms       Room[]
  beds        Bed[]
  staffScopes StaffLocationScope[]

  @@unique([hospitalId, id])
  @@unique([hospitalId, floorId, code])
}

model Room {
  id         String   @id @default(uuid()) @db.Uuid
  hospitalId String   @db.Uuid
  wardId     String   @db.Uuid
  code       String
  name       String
  roomType   RoomType @default(GENERAL)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  ward       Ward     @relation(fields: [hospitalId, wardId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  beds       Bed[]

  @@unique([hospitalId, id])
  @@unique([hospitalId, wardId, id])
  @@unique([hospitalId, wardId, code])
}

// A Bed is the care location (bed position), not a movable bed asset.
// The (hospitalId, wardId, roomId) foreign key guarantees an optional room
// belongs to the bed's own ward.
model Bed {
  id              String           @id @default(uuid()) @db.Uuid
  hospitalId      String           @db.Uuid
  wardId          String           @db.Uuid
  roomId          String?          @db.Uuid
  code            String
  displayName     String
  bedType         BedType          @default(STANDARD)
  status          BedStatus        @default(AVAILABLE)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ward            Ward             @relation(fields: [hospitalId, wardId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  room            Room?            @relation(fields: [hospitalId, wardId, roomId], references: [hospitalId, wardId, id], onDelete: Restrict, onUpdate: Restrict)
  qrCode          BedQrCode?
  sessions        BedSession[]
  serviceRequests ServiceRequest[]

  @@unique([hospitalId, id])
  @@unique([hospitalId, wardId, code])
  @@index([hospitalId, roomId])
}

// One QR code per bed. Only the SHA-256 hash of the token is stored. Rotation
// replaces the hash and increments version, so the previous token stops
// resolving immediately; history is kept in AuditLog.
model BedQrCode {
  id         String       @id @default(uuid()) @db.Uuid
  hospitalId String       @db.Uuid
  bedId      String       @db.Uuid
  tokenHash  String       @unique
  status     QrCodeStatus @default(ACTIVE)
  version    Int          @default(1)
  issuedAt   DateTime     @default(now())
  rotatedAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  hospital   Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  bed        Bed          @relation(fields: [hospitalId, bedId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([hospitalId, id])
  @@unique([hospitalId, bedId])
}

// One admission/occupancy period of a bed, without patient identity.
// At most one ACTIVE session per bed is enforced by the partial unique index
// "BedSession_one_active_per_bed" in the migration SQL (Prisma cannot express it).
model BedSession {
  id                    String           @id @default(uuid()) @db.Uuid
  hospitalId            String           @db.Uuid
  bedId                 String           @db.Uuid
  status                BedSessionStatus @default(ACTIVE)
  startedAt             DateTime         @default(now())
  endedAt               DateTime?
  startedByMembershipId String           @db.Uuid
  closedByMembershipId  String?          @db.Uuid
  hospital              Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  bed                   Bed              @relation(fields: [hospitalId, bedId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  guestSessions         GuestSession[]
  serviceRequests       ServiceRequest[]

  @@unique([hospitalId, id])
  @@unique([hospitalId, bedId, id])
  @@index([hospitalId, status, startedAt])
}

// Short-lived patient/attendant access created by scanning a QR code. The
// (hospitalId, bedId, bedSessionId) foreign key guarantees the session's bed
// is the bed of its BedSession.
model GuestSession {
  id             String     @id @default(uuid()) @db.Uuid
  hospitalId     String     @db.Uuid
  bedId          String     @db.Uuid
  bedSessionId   String     @db.Uuid
  tokenHash      String     @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime   @default(now())
  lastActivityAt DateTime   @default(now())
  hospital       Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  bedSession     BedSession @relation(fields: [hospitalId, bedId, bedSessionId], references: [hospitalId, bedId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([hospitalId, bedSessionId])
  @@index([hospitalId, bedId])
  @@index([expiresAt])
}

// Organizational unit that serves requests (Nursing, Housekeeping, ...).
// Departments are per-hospital data; new hospitals get editable examples.
model Department {
  id              String            @id @default(uuid()) @db.Uuid
  hospitalId      String            @db.Uuid
  code            String
  name            String
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  hospital        Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  staff           StaffDepartment[]
  shifts          Shift[]
  services        ServiceItem[]
  serviceRequests ServiceRequest[]

  @@unique([hospitalId, id])
  @@unique([hospitalId, code])
}

model StaffDepartment {
  id           String             @id @default(uuid()) @db.Uuid
  hospitalId   String             @db.Uuid
  membershipId String             @db.Uuid
  departmentId String             @db.Uuid
  createdAt    DateTime           @default(now())
  membership   HospitalMembership @relation(fields: [hospitalId, membershipId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  department   Department         @relation(fields: [hospitalId, departmentId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([hospitalId, membershipId, departmentId])
  @@index([hospitalId, departmentId])
}

// Where a staff member works and can receive requests. This is operational
// coverage, separate from the authorization ScopeAssignment on a role.
// HOSPITAL covers every location; FLOOR and WARD reference a real location.
// Shape and HOSPITAL-uniqueness are enforced by CHECK and partial unique
// constraints in the migration SQL.
model StaffLocationScope {
  id           String             @id @default(uuid()) @db.Uuid
  hospitalId   String             @db.Uuid
  membershipId String             @db.Uuid
  scopeType    ScopeType
  floorId      String?            @db.Uuid
  wardId       String?            @db.Uuid
  createdAt    DateTime           @default(now())
  membership   HospitalMembership @relation(fields: [hospitalId, membershipId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  floor        Floor?             @relation(fields: [hospitalId, floorId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  ward         Ward?              @relation(fields: [hospitalId, wardId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([hospitalId, id])
  @@unique([hospitalId, membershipId, floorId])
  @@unique([hospitalId, membershipId, wardId])
  @@index([hospitalId, floorId])
  @@index([hospitalId, wardId])
}

// A scheduled work period. Informational in V1: routing uses dutyStatus.
model Shift {
  id                    String             @id @default(uuid()) @db.Uuid
  hospitalId            String             @db.Uuid
  membershipId          String             @db.Uuid
  departmentId          String?            @db.Uuid
  startsAt              DateTime
  endsAt                DateTime
  createdByMembershipId String             @db.Uuid
  createdAt             DateTime           @default(now())
  membership            HospitalMembership @relation(fields: [hospitalId, membershipId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  department            Department?        @relation(fields: [hospitalId, departmentId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([hospitalId, id])
  @@index([hospitalId, membershipId, startsAt])
  @@index([hospitalId, startsAt])
}

// A patient-facing group of services. emergencyNotice shows the "not for
// emergencies" disclaimer next to the group (for example Nursing Help).
model ServiceCategory {
  id              String        @id @default(uuid()) @db.Uuid
  hospitalId      String        @db.Uuid
  name            String
  description     String?
  sortOrder       Int           @default(0)
  emergencyNotice Boolean       @default(false)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  items           ServiceItem[]

  @@unique([hospitalId, id])
  @@unique([hospitalId, name])
}

// A service a patient can request. Department and SLA policy are required.
// Requests snapshot this configuration, so later edits never change them.
model ServiceItem {
  id                 String            @id @default(uuid()) @db.Uuid
  hospitalId         String            @db.Uuid
  categoryId         String            @db.Uuid
  departmentId       String            @db.Uuid
  slaPolicyId        String            @db.Uuid
  escalationPolicyId String?           @db.Uuid
  name               String
  description        String?
  priority           RequestPriority   @default(NORMAL)
  sortOrder          Int               @default(0)
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  category           ServiceCategory   @relation(fields: [hospitalId, categoryId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  department         Department        @relation(fields: [hospitalId, departmentId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  slaPolicy          SlaPolicy         @relation(fields: [hospitalId, slaPolicyId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  escalationPolicy   EscalationPolicy? @relation(fields: [hospitalId, escalationPolicyId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  serviceRequests    ServiceRequest[]

  @@unique([hospitalId, id])
  @@unique([hospitalId, name])
  @@index([hospitalId, categoryId])
  @@index([hospitalId, departmentId])
  @@index([hospitalId, slaPolicyId])
  @@index([hospitalId, escalationPolicyId])
}

// Named SLA. Changing its timings creates a new immutable version; requests
// keep the version they were created with.
model SlaPolicy {
  id              String             @id @default(uuid()) @db.Uuid
  hospitalId      String             @db.Uuid
  name            String
  currentVersion  Int                @default(1)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  hospital        Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  versions        SlaPolicyVersion[]
  services        ServiceItem[]
  serviceRequests ServiceRequest[]

  @@unique([hospitalId, id])
  @@unique([hospitalId, name])
}

// Immutable: a database trigger rejects UPDATE. Both targets are measured
// from submission, so completeMinutes >= acceptMinutes (CHECK constraint).
model SlaPolicyVersion {
  id                    String           @id @default(uuid()) @db.Uuid
  hospitalId            String           @db.Uuid
  slaPolicyId           String           @db.Uuid
  version               Int
  acceptMinutes         Int
  completeMinutes       Int
  createdByMembershipId String?          @db.Uuid
  createdAt             DateTime         @default(now())
  slaPolicy             SlaPolicy        @relation(fields: [hospitalId, slaPolicyId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  serviceRequests       ServiceRequest[]

  @@unique([hospitalId, id])
  @@unique([hospitalId, slaPolicyId, version])
}

// Ordered steps taken after an SLA deadline is missed. Executed in the SLA
// worker phase; configured here.
model EscalationPolicy {
  id              String            @id @default(uuid()) @db.Uuid
  hospitalId      String            @db.Uuid
  name            String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  hospital        Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  levels          EscalationLevel[]
  services        ServiceItem[]
  serviceRequests ServiceRequest[]

  @@unique([hospitalId, id])
  @@unique([hospitalId, name])
}

// afterMinutes counts from the missed deadline. A ROLE target notifies holders
// of that hospital role (for example a manager role); nothing is hardcoded.
model EscalationLevel {
  id                 String           @id @default(uuid()) @db.Uuid
  hospitalId         String           @db.Uuid
  escalationPolicyId String           @db.Uuid
  level              Int
  afterMinutes       Int
  targetType         EscalationTarget
  roleId             String?          @db.Uuid
  policy             EscalationPolicy @relation(fields: [hospitalId, escalationPolicyId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  role               Role?            @relation(fields: [hospitalId, roleId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([hospitalId, escalationPolicyId, level])
  @@index([hospitalId, roleId])
}

// Request configuration is snapshotted at submission. All parent references
// are tenant-scoped; future routing modes are represented but not enabled yet.
model ServiceRequest {
  id                  String              @id @default(uuid()) @db.Uuid
  publicId            String              @unique
  hospitalId          String              @db.Uuid
  bedId               String              @db.Uuid
  bedSessionId        String              @db.Uuid
  serviceId           String              @db.Uuid
  serviceName         String
  categoryName        String
  departmentId        String              @db.Uuid
  assigneeId          String?             @db.Uuid
  priority            RequestPriority
  status              RequestStatus       @default(SUBMITTED)
  assignmentMode      AssignmentMode      @default(MANUAL)
  routingRuleId       String?             @db.Uuid
  slaPolicyId         String              @db.Uuid
  slaPolicyVersionId  String              @db.Uuid
  slaPolicyVersion    Int
  acceptMinutes       Int
  completeMinutes     Int
  escalationPolicyId  String?             @db.Uuid
  isEscalated         Boolean             @default(false)
  escalationLevel     Int                 @default(0)
  acceptDueAt         DateTime
  completeDueAt       DateTime
  submittedAt         DateTime            @default(now())
  assignedAt          DateTime?
  acceptedAt          DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  closedAt            DateTime?
  cancelledAt         DateTime?
  rejectedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  version             Int                 @default(1)
  hospital            Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  bed                 Bed                 @relation(fields: [hospitalId, bedId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  bedSession          BedSession          @relation(fields: [hospitalId, bedId, bedSessionId], references: [hospitalId, bedId, id], onDelete: Restrict, onUpdate: Restrict)
  service             ServiceItem         @relation(fields: [hospitalId, serviceId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  department          Department          @relation(fields: [hospitalId, departmentId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  assignee            HospitalMembership? @relation(fields: [hospitalId, assigneeId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  slaPolicy           SlaPolicy           @relation(fields: [hospitalId, slaPolicyId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  slaPolicyVersionRow SlaPolicyVersion    @relation(fields: [hospitalId, slaPolicyVersionId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  escalationPolicy    EscalationPolicy?   @relation(fields: [hospitalId, escalationPolicyId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)
  events              RequestEvent[]

  @@unique([hospitalId, id])
  @@index([hospitalId, status, submittedAt])
  @@index([hospitalId, bedSessionId, submittedAt])
  @@index([hospitalId, assigneeId, status])
  @@index([hospitalId, submittedAt])
}

// Append-only history. The migration protects this with a database trigger.
model RequestEvent {
  id              String           @id @default(uuid()) @db.Uuid
  hospitalId      String           @db.Uuid
  requestId       String           @db.Uuid
  type            RequestEventType
  previousStatus  RequestStatus?
  resultingStatus RequestStatus
  actorType       RequestActorType
  actorId         String?          @db.Uuid
  occurredAt      DateTime         @default(now())
  reason          String?
  metadata        Json             @default("{}")
  requestVersion  Int
  correlationId   String?
  request         ServiceRequest   @relation(fields: [hospitalId, requestId], references: [hospitalId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([hospitalId, requestId, requestVersion])
  @@index([hospitalId, requestId, occurredAt])
  @@index([hospitalId, actorId])
}
