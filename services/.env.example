NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://careqr:careqr@localhost:5432/careqr?schema=public
# Optional: nothing needs Redis yet. When set, it must be reachable at start-up.
REDIS_URL=redis://localhost:6379
# The web app address. Printed QR codes link here, and it may call the API.
# Required in production (for example https://care-qr.vercel.app).
PUBLIC_APP_URL=http://localhost:5173
# Optional: other web addresses allowed to call the API, comma-separated.
CORS_ORIGINS=
# Proxies in front of the API: 3 on Render (Cloudflare, load balancer, local
# proxy). Defaults to 1 in production, 0 otherwise.
TRUST_PROXY=
GUEST_SESSION_TTL_MINUTES=120
# Optional: how often (seconds) the SLA worker escalates overdue requests;
# 0 turns it off in this process. Default 60.
ESCALATION_INTERVAL_SECONDS=
# Optional: on stop or redeploy, seconds that requests in progress may take
# to finish. Default 10.
SHUTDOWN_TIMEOUT_SECONDS=
